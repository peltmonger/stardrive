{
  "name": "stardrive",
  "version": "1.6.0",
  "stardriveVersion": "1.5.15",
  "private": true,
  "description": "The Astro boilerplate to create super stable and fast websites in the AI age",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "prebuild": "npm run sync-version",
    "postbuild": "scripts/postbuild.js",
    "purge:cloudflare": "node scripts/purgeCloudflareCache.js",
    "check": "npm run check:astro && npm run check:type && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:type": "npm run generate-types && tsc --noEmit",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "check:artifacts": "node scripts/verifyBuildArtifacts.js",
    "fix": "npm run sync-version && npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "generate-types": "wrangler types",
    "test": "npm run check:astro",
    "sync-version": "node scripts/syncVersion.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peltmonger/stardrive.git"
  },
  "keywords": [
    "astro",
    "boilerplate",
    "starter",
    "template",
    "website",
    "static",
    "fast",
    "stable",
    "llm",
    "ai"
  ],
  "author": {
    "name": "Peltmonger Ventures GmbH",
    "url": "https://peltmonger.com/"
  },
  "maintainers": [
    {
      "name": "Jens Kuerschner",
      "url": "https://jekuer.com/"
    }
  ],
  "license": "MIT",
  "funding": "https://github.com/peltmonger/stardrive?sponsor=1",
  "type": "module",
  "bugs": {
    "url": "https://github.com/peltmonger/stardrive/issues"
  },
  "homepage": "https://astro-stardrive.com/",
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "add-to-calendar-button": "^3.3.0",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "leaflet": "^1.9.4",
    "pmtiles": "^4.5.0",
    "protomaps-leaflet": "^5.1.0",
    "sanitize-html": "^2.18.0",
    "slot-text": "^0.3.4",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.145.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/ts-plugin": "^1.10.12",
    "@eslint/js": "^10.0.1",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/thesvg": "^1.2.7",
    "@types/leaflet": "^1.9.22",
    "@types/sanitize-html": "^2.16.2",
    "astro-compress": "^2.4.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.1.0",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
